# Server-only credentials. Restart Next.js after changing these.
# Create a Formspree form with contact@parasharguruji.com as its verified recipient.
# Copy only the ID from https://formspree.io/f/YOUR_ID.
FORMSPREE_FORM_ID=
SHUBH_API_KEY=
# Optional: licensed Open-Meteo customer key for worldwide city search.
# Without it, the curated city list and GPS coordinate lookup still work.
GEOCODING_API_KEY=
# A trusted HTTPS endpoint that delivers enquiries; return 2xx only on acceptance.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=
